{
  "name": "header-content-layout",
  "version": "0.11.0",
  "description": "Schema-driven data shell: a query header over a switchable results area, with the query held in the URL.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/fixtures.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6011 --no-open",
    "build-storybook": "storybook build",
    "preversion": "npm run lint && npm run typecheck && npm run build && npm test",
    "version": "npm run build && git add dist",
    "postversion": "git push origin main --follow-tags"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.0.0 || ^4.0.0",
    "vue": "^3.4.0",
    "vue-router": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nuxt/kit": "^4.0.0",
    "@playwright/test": "^1.62.1",
    "@storybook/vue3-vite": "^10.5.10",
    "@types/node": "^26.3.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^25.0.1",
    "storybook": "^10.5.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0",
    "vue3-sfc-loader": "^0.9.5"
  },
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "layout",
    "data-grid",
    "query",
    "facets",
    "url-state"
  ]
}
